# =============================================================================
# ArcGIS Enterprise Bootstrap Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Domain Configuration (OPTIONAL - auto-detected from hostname -f)
# Set this to your public domain if different from system hostname
# -----------------------------------------------------------------------------
#ARCGIS_FQDN=gis.example.com

# -----------------------------------------------------------------------------
# Admin Credentials (REQUIRED)
# WARNING: Use strong passwords (min 8 chars, mixed case, numbers, special chars)
# -----------------------------------------------------------------------------
ARCGIS_ADMIN_USER=admin
ARCGIS_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
ARCGIS_ADMIN_EMAIL=admin@example.com
ARCGIS_ADMIN_FIRSTNAME=Admin
ARCGIS_ADMIN_LASTNAME=User
# Security question index (1-14). See README for list of questions.
# 1=What city were you born in? 2=High school mascot? 3=Mother's maiden name?
# 4=Make of first car? 5=High school? 6=Best friend's last name?
# 7=Youngest sibling's middle name? 8=Street you grew up on?
# 9=Favorite fictional character? 10=Favorite pet's name?
# 11=Favorite restaurant? 12=Favorite book? 13=Dream job? 14=First date location?
ARCGIS_ADMIN_SECURITY_QUESTION_INDEX=1
ARCGIS_ADMIN_SECURITY_ANSWER=secret_answer

# -----------------------------------------------------------------------------
# License Files (OPTIONAL - auto-discovered from /opt/esri/licenses/)
# Only set these if you need to override auto-discovery
# -----------------------------------------------------------------------------
# Server license: auto-discovers *.prvc files
#ARCGIS_SERVER_LICENSE=/opt/esri/licenses/your_server_license.prvc
# Portal license: auto-discovers *Portal*.json files
#ARCGIS_PORTAL_LICENSE=/opt/esri/licenses/your_portal_license.json

# -----------------------------------------------------------------------------
# Installer Path (OPTIONAL - auto-discovered from /opt/esri/installers/)
# Only set this if you need to override auto-discovery
# -----------------------------------------------------------------------------
# Installer: auto-discovers ArcGIS_Enterprise_Builder_Linux*.tar.gz
#ARCGIS_INSTALLER_TAR=/opt/esri/installers/ArcGIS_Enterprise_Builder_Linux_120_XXXXXX.tar.gz

# -----------------------------------------------------------------------------
# Installation Directories
# -----------------------------------------------------------------------------
ARCGIS_INSTALL_DIR=/opt/esri/arcgis
ARCGIS_DATA_DIR=/opt/esri/data
ARCGIS_CONFIG_STORE=/opt/esri/data/config-store
ARCGIS_SERVER_DIRS=/opt/esri/data/server-dirs
ARCGIS_PORTAL_CONTENT=/opt/esri/data/portal-content

# -----------------------------------------------------------------------------
# OS User (will be created if doesn't exist)
# -----------------------------------------------------------------------------
ARCGIS_RUN_AS_USER=arcgis

# -----------------------------------------------------------------------------
# SSL / Let's Encrypt Configuration
# -----------------------------------------------------------------------------
LETSENCRYPT_EMAIL=admin@example.com
# Set to "true" for testing (uses staging server, avoids rate limits)
LETSENCRYPT_STAGING=false

# -----------------------------------------------------------------------------
# Cloudflare DNS Challenge (OPTIONAL)
# If set, uses Cloudflare DNS-01 challenge instead of HTTP-01
# Benefits: No port 80 needed, can issue before VM is public, supports wildcards
# Create token at: https://dash.cloudflare.com/profile/api-tokens
# Required permissions: Zone:DNS:Edit for your domain
# -----------------------------------------------------------------------------
#CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# -----------------------------------------------------------------------------
# Advanced Options (usually don't need to change)
# -----------------------------------------------------------------------------
# Web Adaptor context names
WEB_ADAPTOR_SERVER_CONTEXT=server
WEB_ADAPTOR_PORTAL_CONTEXT=portal
